# MongoDB connection string (database name is "my_portfolio")
MONGODB_URI=your_mongodb_uri_here

# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# Admin login. In production the panel stays locked until one of these is set to a real value.
ADMIN_USERNAME=admin
# Preferred: a hash from  python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
ADMIN_PASSWORD_HASH=
# Plain-text alternative, fine for local development only
ADMIN_PASSWORD=password

# Public URL, used for canonical links, the sitemap and robots.txt
SITE_URL=https://klhportfolio.vercel.app

# Optional: days of analytics to keep (default 365)
ANALYTICS_RETENTION_DAYS=365
